.stretch {
    width: 100%;
    height: 100%;
}

.stack {
    display: flex;
    gap: 2px;
}
.stack.vertical {
    flex-direction: column;
}
.stack.horizontal {
    flex-direction: row;
}

.panel {
    pointer-events: auto;
}

.block {
    display: flex;
    flex-direction: row;
    border: 2px outset;

    text-align: center;
    align-items: center;
    justify-content: center;
}

.section {
    background: #121c40;
    border: 3px solid #3d5bb5;
    display: flex;
    color: white;

    /*box-shadow:*/
    /*        0 0 0 2px #0a1128,*/
    /*        inset 0 0 0 2px #0a1128,*/
    /*        inset 2px 2px 0 3px #2a3f85,*/
    /*        inset -2px -2px 0 3px #0d1534;*/
}

.value {
    width: 8em;
    height: 2em;

    background-color: black;
    color: white;
    font-size: 16px;
    border-color: #1d2749;
    border-radius: 8px;
}