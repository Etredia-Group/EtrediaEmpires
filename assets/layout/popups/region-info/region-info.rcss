#region-info {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 26%;
    height: 27.7%;

    display: flex;
    flex-direction: column;
    gap: 2px;
}

#region-header {
    flex: 18 1 0;
    display: flex;
    flex-direction: row;
    gap: 2px;
}

#region-owner {
    flex: 18 1 0;
}

#region-name {
    flex: 82 1 0;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    text-transform: uppercase;
}

#region-description {
    flex: 82 1 0;
    background-color: #26335F;

    display: flex;
    flex-direction: row;
    gap: 2px;
}

#region-chart {
    flex: 33 1 0;
}

#region-right {
    flex: 67 1 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
}

#region-stats {
    flex: 40 1 0;
}

#region-controls {
    flex: 60 1 0;
}

.flat-section {
    background-color: #151E3D;
}