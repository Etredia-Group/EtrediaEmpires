#load-panel {
    width: 100%;
    height: 100%;

    /*border-width: 4px;
    border-style: solid;
    border-color: #3d5bb5;*/
}

#load-panel * {
    position: absolute;
}

#load-tooltip {
    font-size: 26px;
    width: 50%;
    top: 50%;
    transform: translateY(-50%);
    left: 18px;
}

#load-bar {
    top: 18px;
    left: 18px;
    width: 50%;
    height: 46px;

    flex-direction: column;
    align-items: center;
}

#load-bar span {
    position: relative;
}

#stage {
    text-align: center;
    text-transform: uppercase;
    width: 100%;
    font-size: 22px;
}

#progress-value {
    text-align: center;
    width: 100%;
    font-size: 12px;
}

#progress {
    height: 100%;
    width: 50%;
    position: absolute;
    left: 50%;
    transform: translateX(-50%);

    background-color: #3d5bb5;
}