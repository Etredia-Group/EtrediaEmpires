<rml>

<head>
    <link type="text/css" href="@ui/base.rcss" />
    <link type="text/css" href="@ui/game.rcss" />
    <link type="text/css" href="loadscreen.rcss" />
</head>

<body data-model="LoadingInfo" class="panel">
    <div id="load-panel">
        <img class="stretch" src="@gfx/base-bg.png" />
        <img class="stretch" src="@gfx/loadscreens/1.png" />
        <div id="load-bar" class="section">
            <div id="progress" data-style-width="progress + '%'" />
            <span id="stage">{{stage|t('load-stages',lang)}}</span>
            <span id="progress-value">{{(progress | format(0))}}%</span>
        </div>
        <span id="load-tooltip">{{quote}}</span>
    </div>
</body>

</rml>